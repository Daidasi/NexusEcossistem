# Required for production. Keep actual values in a secret manager, never Git.
DATABASE_URL=
APP_ORIGIN=
# Generate 32 random bytes, base64-encoded. Persist/back up this key securely.
NEXUS_ENCRYPTION_KEY=
# Optional invite-only beta registration code. Set for any hosted beta.
NEXUS_REGISTRATION_CODE=
# Local development only; refused by the application in production.
NEXUS_LOCAL_DB=0
NEXT_TELEMETRY_DISABLED=1
# Tests only: dedicated disposable database; never point this at production.
NEXUS_TEST_DATABASE_URL=
NEXUS_E2E_URL=
